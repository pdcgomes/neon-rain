{
  "name": "syndicate-reborn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A modern reinterpretation of Syndicate with Cannon Fodder-style fluid controls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:smoke": "node scripts/sim-smoke.ts",
    "sim:traffic": "node scripts/traffic-check.ts",
    "sim:balance": "node scripts/balance.ts",
    "lab:e2e": "node scripts/lab-e2e.ts",
    "art:tripo": "NODE_USE_ENV_PROXY=1 node tools/art/tripo.ts",
    "art:mixamo": "node tools/art/mixamo-pack.ts",
    "synd": "node tools/syndicate/cli.ts",
    "synd:convert": "node tools/syndicate/cli.ts convert"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "postprocessing": "^6.36.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
